
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Strategy (follow persistent taker flow, BTC 15-minute Up/Down) ──
# The market and its 60s TWAP lookback are fixed in code, not configured here.
#
# A burst is this many taker prints of at least this many shares, on the same
# side of one market, inside this many milliseconds. One large print carries
# no information on these books; two or more inside three seconds did.
FLOW_MIN_PRINT_SHARES=50
FLOW_MIN_PRINTS=2
FLOW_BURST_MS=3000
# Listen for bursts between these two times before window close. Bursts at
# prices with real upside happen almost only in the 60-120s zone; later the
# book has already priced the side.
ENTRY_WINDOW_OPEN_SECONDS=120
ENTRY_WINDOW_CLOSE_SECONDS=10
# Buy the burst side only when its executable ask sits within this band. Above
# 0.70 following flow measured negative; below 0.15 the fills are noise.
MIN_ENTRY_PRICE=0.15
MAX_ENTRY_PRICE=0.70
# The settlement forecast never picks a trade; it only vetoes a burst that runs
# against a side it is this many standard deviations confident about.
VETO_SD_MULTIPLE=3
# Skip a market whose CLOB has not printed a real fill this recently. Every
# fill the simulator ever took at a "stale" price was on a market the exchange
# had stopped matching.
MARKET_LIVENESS_MS=120000
# Trailing window (ms) for per-second volatility of the RAW Chainlink feed.
SIGMA_WINDOW_MS=180000
# Refuse to trade when the raw feed is older than this.
MAX_RAW_STALENESS_MS=5000
# Stop trigger, as a fraction of entry price. Always active — there is no way to
# turn it off. The trigger only decides WHEN to sell; the fill is whatever the
# book holds at that moment and can be far worse.
STOP_LOSS_FRACTION=0.35
# Polymarket's taker delay on crypto markets (50ms since 2026-08-17). The book
# is re-read after the hold, for entries and exits alike.
EXECUTION_LATENCY_MS=50
SCAN_INTERVAL_MS=60000
STARTING_CAPITAL=10

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure
